# Package commands; also reachable from kernel via just modules::<path>::<recipe>.
set positional-arguments


# List this package and its child modules.
default:
    @just --justfile justfile --list

# Check dk-tensor; extra Cargo arguments are forwarded verbatim.
check *args:
    cargo check --locked --manifest-path Cargo.toml -p dk-tensor "$@"

# Build dk-tensor; extra Cargo arguments are forwarded verbatim.
build *args:
    cargo build --locked --manifest-path Cargo.toml -p dk-tensor "$@"

# Test dk-tensor; extra Cargo arguments are forwarded verbatim.
test *args:
    cargo test --locked --manifest-path Cargo.toml -p dk-tensor "$@"

# Clippy dk-tensor; extra Cargo arguments are forwarded verbatim.
lint *args:
    cargo clippy --locked --manifest-path Cargo.toml -p dk-tensor "$@"

fmt:
    cargo fmt --manifest-path Cargo.toml -- --check
